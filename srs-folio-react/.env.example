# ========================================
# SRS Portfolio - Environment Variables Example
# ========================================
# Copy this file to .env and fill in your actual values
# Add production variables to Vercel dashboard
# NEVER commit .env to Git (it's in .gitignore)
# ========================================

# ========================================
# VISITOR TRACKING (Upstash Redis) - REQUIRED
# ========================================
# Get these from: https://console.upstash.com/
# Database name suggestion: srs-folio-visitors
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ========================================
# CONTACT FORM (Formspree) - OPTIONAL
# ========================================
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id_here

# ========================================
# ANALYTICS (Google Analytics) - OPTIONAL
# ========================================
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GTM_ID=GTM-XXXXXXX

# ========================================
# AUTHENTICATION - FUTURE USE
# ========================================
# VITE_AUTH_DOMAIN=your_auth_domain
# VITE_AUTH_CLIENT_ID=your_client_id

# ========================================
# DATABASE - FUTURE USE
# ========================================
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# ========================================
# EMAIL SERVICES - FUTURE USE
# ========================================
# SENDGRID_API_KEY=your_sendgrid_key
# RESEND_API_KEY=your_resend_key

# ========================================
# STORAGE & CDN - FUTURE USE
# ========================================
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_API_KEY=your_api_key

# ========================================
# AI SERVICES - FUTURE USE
# ========================================
# OPENAI_API_KEY=sk-your_openai_key
# VITE_GEMINI_API_KEY=your_gemini_key

# ========================================
# SOCIAL MEDIA APIS - FUTURE USE
# ========================================
# VITE_GITHUB_TOKEN=ghp_your_github_token
# VITE_GITHUB_USERNAME=SR-Sujon

# ========================================
# ERROR TRACKING - FUTURE USE
# ========================================
# VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project

# ========================================
# NOTES
# ========================================
# Variables with VITE_ prefix: Exposed to client-side code
# Variables without VITE_: Server-side only (API routes)
# Restart dev server after changing environment variables
# ========================================
